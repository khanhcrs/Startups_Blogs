# Server Port
PORT=3000

# Database Configuration (PostgreSQL / AWS RDS)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRATION="7d"

# AWS S3 Storage (Using EC2 IAM Role or Custom Keys)
AWS_S3_BUCKET="your-s3-bucket-name"
AWS_S3_REGION="us-east-1"
# AWS_S3_ACCESS_KEY="optional-if-running-locally"
# AWS_S3_SECRET_KEY="optional-if-running-locally"

# Amazon Cognito User Pool
COGNITO_USER_POOL_ID="us-east-1_xxxxxxxxx"
COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional override; backend otherwise derives the region from COGNITO_USER_POOL_ID.
COGNITO_REGION="us-east-1"
